# Dynamic theme colors
theme = GitHub Dark Default
# T3 Code surfaces, keeping GitHub's ANSI syntax colors.
background = #0a0a0a
foreground = #f5f5f5
cursor-color = #b4cbff
selection-background = #343a47
selection-foreground = #f5f5f5

# Hide the titlebar but keep native window borders and rounded corners
macos-titlebar-style = hidden

# Background transparency and blur
background-opacity = 1
background-blur = true

# Window padding
window-padding-x = 4,0
window-padding-y = 10,0

# Font
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 16

# Keyboard bindings
keybind = f11=toggle_fullscreen
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = alt+shift+enter=csi:13;4u

mouse-hide-while-typing = true

keybind = shift+enter=text:\x1b[13;2u

clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
