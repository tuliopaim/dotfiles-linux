#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

remote="${SSPASTE_REMOTE:-tuliopaim@192.168.1.186}"
image=$(ls -t ~/storage/{pictures,dcim}/Screenshots/* 2>/dev/null | head -n1)
[[ -n "$image" ]] || { echo "No screenshot found" >&2; exit 1; }

path="pi-paste-$(date +%s).${image##*.}"
scp "$image" "$remote:$path"
echo "Uploaded: ~/$path"
