#!/usr/bin/env bash
# Manage the shared OpenCode v2 service and start it at login.
# OpenCode owns the server process; launchd only runs the login bootstrap.
#
# Usage: opencode2-web [start|stop|restart|status|url]
#   (no args)  ensure running, print local + Tailscale URLs with QR codes

set -euo pipefail

LABEL="com.tuliopaim.opencode2-web"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
PORT=4577
PASSWORD="phone-open-4577"
OPENCODE2="$HOME/.bun/bin/opencode2"

write_plist() {
  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${OPENCODE2}</string>
    <string>service</string>
    <string>start</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/opencode2-web.log</string>
  <key>StandardErrorPath</key><string>/tmp/opencode2-web.log</string>
</dict>
</plist>
EOF
}

configure_service() {
  [[ "$($OPENCODE2 service get hostname)" == "127.0.0.1" ]] || \
    "$OPENCODE2" service set hostname 127.0.0.1
  [[ "$($OPENCODE2 service get port)" == "$PORT" ]] || \
    "$OPENCODE2" service set port "$PORT"
  [[ "$($OPENCODE2 service get password)" == "$PASSWORD" ]] || \
    "$OPENCODE2" service set password "$PASSWORD"
}

is_loaded() {
  launchctl list "$LABEL" &>/dev/null
}

is_running() {
  "$OPENCODE2" service status &>/dev/null
}

install_bootstrap() {
  if is_loaded && [[ -f "$PLIST" ]] && \
    [[ "$(plutil -extract ProgramArguments.1 raw "$PLIST" 2>/dev/null || true)" == "service" ]] && \
    [[ "$(plutil -extract ProgramArguments.2 raw "$PLIST" 2>/dev/null || true)" == "start" ]]; then
    return
  fi
  if is_loaded; then
    launchctl unload "$PLIST"
  fi
  write_plist
  launchctl load "$PLIST"
}

tailscale_dns() {
  command -v tailscale >/dev/null && \
    tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // ""' | sed 's/\.$//' || echo ""
}

print_urls() {
  local dns user="opencode"
  echo
  echo "OpenCode v2 web UI (user: ${user}, pass: ${PASSWORD})"
  echo "  Local     : http://127.0.0.1:${PORT}"
  if dns="$(tailscale_dns)" && [[ -n "$dns" ]]; then
    echo "  Tailscale : https://${dns}"
    if command -v qrencode >/dev/null; then
      qrencode -t utf8 "https://${dns}"
    fi
  else
    echo "  Tailscale : unavailable (configure Tailscale Serve)"
  fi
}

case "${1:-}" in
  start)
    configure_service
    install_bootstrap
    "$OPENCODE2" service start >/dev/null
    echo "Started."
    ;;
  stop)
    was_active=false
    if is_loaded; then
      was_active=true
      launchctl unload "$PLIST"
    fi
    if is_running; then
      was_active=true
      "$OPENCODE2" service stop >/dev/null 2>&1 || true
    fi
    if "$was_active"; then
      echo "Stopped."
    else
      echo "Not running."
    fi
    ;;
  restart)
    configure_service
    install_bootstrap
    "$OPENCODE2" service restart >/dev/null
    echo "Restarted."
    ;;
  status)
    if is_running; then
      echo "Running shared service (port: ${PORT})"
      curl -s -m 3 -o /dev/null -u "opencode:${PASSWORD}" \
        -w "health check: HTTP %{http_code}\n" "http://127.0.0.1:${PORT}/api/health" || true
    else
      echo "Not running."
    fi
    ;;
  url)
    print_urls
    ;;
  "")
    "$0" start
    print_urls
    ;;
  *)
    echo "Usage: opencode2-web [start|stop|restart|status|url]" >&2
    exit 2
    ;;
esac
